# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000

# ==========================================
# Database (PostgreSQL & Prisma)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_onboarding?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=employee_onboarding
POSTGRES_PORT=5432

# ==========================================
# Clerk Authentication
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ==========================================
# Redis (BullMQ & Notification Queues)
# ==========================================
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# ==========================================
# Email Service Configuration
# Options: console | smtp | sendgrid | aws_ses | resend
# ==========================================
EMAIL_PROVIDER=console
EMAIL_FROM="onboarding@company.com"

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend API Key (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ==========================================
# AWS S3 Storage (for Document Management)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=company-employee-documents
